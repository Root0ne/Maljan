# =============================================================================
# Maljan API - apps/api/.env.example
# =============================================================================
#
# Template for the FastAPI backend (``apps/api/app/config.py:APISettings``).
# When you run the API outside the docker stack, copy this file to
# ``apps/api/.env`` and override only the values that diverge from defaults.
#
# Loader behaviour:
#   APISettings searches ".env", "../../.env", "../../../.env" (in that
#   order), so root .env values are visible from apps/api without
#   duplication. This file is the place to set API-only overrides.
#
# Sub-app entry points:
#   - ../../.env.example     - maljan-core (CLI, ARQ worker, agents)
#   - ../web/.env.example    - Next.js frontend (NEXT_PUBLIC_*)
#
# Conventions:
#   - Anything marked [SECRET] must never be committed.
#   - ``# KEY=value`` means the value shown is the default and the key is
#     optional. Real overrides should be uncommented.
# =============================================================================


# ── Application ──────────────────────────────────────────────────────────────
# APP_NAME=Maljan
# APP_VERSION=0.1.0
# DEBUG=true

# When False the API refuses to honour MALJAN_MOCK_MODE from the environment.
# Set to True ONLY for CI / smoke tests that need to run without a sandbox.
# MOCK_MODE_ALLOWED=false


# ── CORS ─────────────────────────────────────────────────────────────────────
# Each list must be valid JSON.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
# CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Correlation-Id"]

# IPs allowed to set X-Forwarded-For for rate-limit identity. Empty list
# means uvicorn peer IP only - the safe default behind no proxy.
# TRUSTED_PROXY_IPS=["10.0.0.0/8"]


# ── Database (PostgreSQL via asyncpg) ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://maljan:maljan_dev@localhost:5433/maljan
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# Auto-run ``alembic upgrade head`` at startup. Disable in production - run
# migrations as a separate deploy step instead.
# RUN_MIGRATIONS_ON_STARTUP=false


# ── Redis (cache + ARQ queue) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ── MinIO / S3 (sample object storage) ───────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
# [SECRET] - boot refuses in non-debug mode while this is "minioadmin".
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=maljan-samples
MINIO_SECURE=false


# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong key: ``openssl rand -hex 32`` (32 bytes = 64 hex chars).
# Boot refuses in non-debug mode when the value is unset, < 32 chars, or a
# known placeholder ("change-me", "secret", etc.).
# [SECRET]
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-OPENSSL-RAND
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_ISSUER=maljan-api
# JWT_AUDIENCE=maljan-clients

# --- Secret rotation (SEC-JWT-ROTATION-01) ----------------------------------
# New tokens carry the ``kid`` header set to ``JWT_KEY_ID``. During rotation:
#   1. Move the current secret to JWT_PREVIOUS_SECRET_KEY and its kid to
#      JWT_PREVIOUS_KEY_ID.
#   2. Set the new secret in JWT_SECRET_KEY and increment JWT_KEY_ID.
#   3. After every old token expires (>= JWT_ACCESS_TOKEN_EXPIRE_MINUTES +
#      JWT_REFRESH_TOKEN_EXPIRE_DAYS), clear the previous fields.
# JWT_KEY_ID=v1
# [SECRET]
# JWT_PREVIOUS_SECRET_KEY=
# JWT_PREVIOUS_KEY_ID=v0


# ── Runtime settings encryption (Settings → Configuration, web UI) ──────────
# Encryption key for secrets saved from the UI. Secrets are stored
# Fernet-encrypted in the ``runtime_settings`` table under this key; without
# it the UI shows secret fields read-only and everything else still works.
# Shared with the ARQ worker (both processes read the same .env). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or rotating this key does not delete the stored secrets: they become
# unreadable (the UI shows them as set-but-unreadable) and the value already
# in the environment stays in effect until you clear the stored secret from
# the UI and re-enter it under the new key.
# [SECRET]
# SETTINGS_ENCRYPTION_KEY=


# ── Login throttle (per-account brute-force lockout) ─────────────────────────
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_LOCKOUT_SECONDS=300


# ── Auth bypass (local dev only - NEVER enable in production) ────────────────
# Skips every JWT check and attributes all requests to a fixed seeded
# admin user. Frontend mirrors this via NEXT_PUBLIC_AUTH_DISABLED. Commented
# out so that copying this template does not produce an unauthenticated API.
# AUTH_DISABLED=true
# AUTH_DISABLED_USER_ID=00000000-0000-0000-0000-000000000001
# AUTH_DISABLED_USER_EMAIL=dev@local
# AUTH_DISABLED_USER_FULL_NAME=Dev User


# ── Qdrant (separate collection from maljan-core memory) ─────────────────────
# Note: maljan-core uses MEMORY__QDRANT_COLLECTION=maljan_cases_v2 (fastembed
# BGE 384-dim). The API stores its own retrievable cases under maljan_ltm.
# Both collections live on the same Qdrant instance.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maljan_ltm


# ── Threat-intel enrichment (Faz 6 enrichment worker) ────────────────────────
# Both keys are optional. Empty values cause the enrichment worker to skip
# the provider and leave reputation fields as null. Fail-safe under quota
# exhaustion and HTTP errors.
# [SECRET]
# VIRUSTOTAL_API_KEY=
# [SECRET]
# ABUSEIPDB_API_KEY=
# ENRICHMENT_ENABLED=true
# ENRICHMENT_MAX_LOOKUPS=25


# ── Rate limiting (slowapi middleware) ───────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_WHITELIST=["/health","/docs","/redoc","/openapi.json"]


# ── File upload limits ───────────────────────────────────────────────────────
# Bytes (default = 100 MiB = 104857600). Bump only after confirming the
# sandbox + storage tier accept the larger payload.
# UPLOAD_MAX_BYTES=104857600
#
# The default UPLOAD_ALLOWED_MIME_TYPES is a 65-entry whitelist that mirrors
# every CAPEv2 analyzer package. Override only when you need a stricter or
# looser policy. Must be valid JSON.
# UPLOAD_ALLOWED_MIME_TYPES=["application/x-dosexec","application/zip", ...]


# ── Pass-through hints for maljan-core (also accepted in root .env) ──────────
# These are not API-specific - APISettings ignores them - but documenting
# them here helps developers running ``uvicorn`` from apps/api directly.
# LLM__PROVIDER=openai
# SANDBOX__BACKEND=cape2
# SANDBOX__CAPE2_BASE_URL=http://localhost:18000
# See ../../.env.example for the full maljan-core surface.
