# ──────────────────────────────────────────────────────────────
# Maljan API Environment Configuration
# Copy this file as .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=Maljan
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://maljan:maljan_dev@localhost:5432/maljan

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO (Object Storage for Samples) ──────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=maljan-samples
MINIO_SECURE=false

# ── JWT Authentication ───────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-OPENSSL-RAND
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Qdrant (Vector Store) ───────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maljan_ltm

# ── Maljan Core (from root .env) ────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key
# TRIAGE_API_KEY=your-triage-api-key
