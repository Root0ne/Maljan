# =============================================================================
# Maljan Web - apps/web/.env.example (Next.js)
# =============================================================================
#
# Frontend environment template. Anything prefixed ``NEXT_PUBLIC_`` is
# inlined into the client bundle at build time and exposed to the browser -
# never put real secrets behind that prefix.
#
# Next.js loads files in this priority order (later wins):
#   1. .env                  (committed defaults, applies everywhere)
#   2. .env.local            (gitignored, never loaded in test)
#   3. .env.development      (next dev only)
#   4. .env.development.local
#   5. .env.production       (next start / next build only)
#   6. .env.production.local
#
# Recommended workflow:
#   cp apps/web/.env.example apps/web/.env.local
#   # Edit values to match your local backend.
# =============================================================================


# ── Backend endpoints ────────────────────────────────────────────────────────
# Base URL of the FastAPI service (apps/api). Used by lib/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time job updates (analysis pipeline streaming).
# Default mirrors NEXT_PUBLIC_API_URL with the ws:// scheme.
NEXT_PUBLIC_WS_URL=ws://localhost:8000


# ── Auth bypass (local dev only) ─────────────────────────────────────────────
# Skip the /login redirect and inject a stub dev user. MUST be paired with
# AUTH_DISABLED=true on the backend (apps/api/.env or root .env). Setting
# this to "true" on a production build leaks an unauthenticated session
# bootstrap to every visitor - NEVER do that.
NEXT_PUBLIC_AUTH_DISABLED=false


# ── Docker build args (advanced) ─────────────────────────────────────────────
# Both NEXT_PUBLIC_API_URL and NEXT_PUBLIC_WS_URL are also accepted as
# ``--build-arg`` values by docker/Dockerfile.frontend. The image bakes the
# resolved values into the static bundle at build time; changing them later
# at container runtime has NO effect on already-built pages.
