# =============================================================================
# Maljan - Root Environment Template
# =============================================================================
#
# This file documents every environment variable read by the Maljan core
# library (``src/maljan/core/config.py``) and the LangChain integration. It
# is the single source of truth for CLI runs and ARQ workers; sub-apps have
# their own templates:
#
#   - apps/api/.env.example   - FastAPI backend (APISettings)
#   - apps/web/.env.example   - Next.js frontend (NEXT_PUBLIC_*)
#
# Quickstart:
#
#   cp .env.example .env
#   # 1. Set LLM__PROVIDER and the matching API key block.
#   # 2. (Optional) Point at a Sandbox backend if you want dynamic analysis.
#   # 3. Everything else has a sensible default and can stay commented out.
#
# Conventions:
#
#   - Nested config fields are flattened with double underscores: the
#     Pydantic field ``settings.llm.openai.api_key`` is set via
#     ``LLM__OPENAI__API_KEY``. Single underscores are NOT recognised for
#     nested fields (a common docker-compose footgun).
#   - Lines that start with ``#`` are comments. The pattern ``# KEY=value``
#     means the key is optional and the documented value is the default.
#   - Anything marked ``[SECRET]`` must never be committed. Copy to your
#     local ``.env`` (gitignored) and rotate immediately if leaked.
# =============================================================================


# =============================================================================
# QUICK START - the minimum required for a real analysis run
# =============================================================================

# Active LLM backend: openai | anthropic | ollama | gemini
LLM__PROVIDER=openai

# Analyst execution topology. TRUE = analysts run in parallel (correct for a
# hosted, multi-slot LLM API). FALSE = sequential — REQUIRED for a single-slot
# local llama.cpp/ollama server (no ``--parallel N``): on one slot, parallel
# analysts interleave and clobber each other's per-slot KV / recurrent state,
# and for a hybrid Gated-DeltaNet model (e.g. Qwen3.6-35B-A3B) that forces a
# full prompt re-processing every ReAct step (llama.cpp#20225 / ik_llama#1762)
# → timeouts + multi-×-slower runs. Measured: parallel 41 min (revision timed
# out) → sequential 12 min, zero timeouts. Keep FALSE for the local stack.
LLM__PARALLEL_ANALYSTS=false

# Convenience shortcuts: auto-promoted into the nested provider config on
# startup so existing setups using flat keys keep working.
# [SECRET]
OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...                       # promotes to LLM__GEMINI__API_KEY


# =============================================================================
# INFRASTRUCTURE - only needed when NOT relying on docker/compose.yml
# =============================================================================
#
# docker compose already injects working values for the in-cluster services
# (postgres, redis, qdrant, minio, ghidra-mcp). Set these only when you run
# the API / worker outside the compose network.

# Toggle dev-only behaviours (verbose logging, relaxed secret validation).
# Off by default: with DEBUG=true the placeholder-credential and auth-bypass
# guards in apps/api/app/config.py do not fire.
# DEBUG=true

# PostgreSQL DSN used by the API + ARQ worker. Driver MUST be asyncpg.
# Local docker stack maps the container to host port 5433 to avoid
# clashing with a system-wide postgres on 5432.
# DATABASE_URL=postgresql+asyncpg://maljan:maljan_dev@localhost:5433/maljan
# POSTGRES_PORT=5433                            # docker-compose port override

# Redis (task queue + cache).
# REDIS_URL=redis://localhost:6379/0

# Object storage for sample bytes (MinIO is S3-compatible).
# MINIO_ENDPOINT=localhost:9000
# MINIO_ROOT_USER=minioadmin
# [SECRET]
# MINIO_ROOT_PASSWORD=minioadmin

# Qdrant for the Long-Term Memory store. The API may use a separate
# collection name (see apps/api/.env.example).
# QDRANT_URL=http://localhost:6333


# =============================================================================
# AUTHENTICATION - shared with the API (apps/api/app/config.py)
# =============================================================================
#
# Full JWT, rate-limit, login throttle and upload-limit knobs live in
# apps/api/.env.example. Repeated here only when needed for CLI scripts that
# import the api package.

# Generate a strong key with: openssl rand -hex 32
# Refuses to boot the API in non-debug mode unless a real value (>= 32 chars
# and not a known placeholder) is provided.
# [SECRET]
JWT_SECRET_KEY=replace-with-`openssl rand -hex 32`-output

# Local-dev only: skip every JWT check and attribute requests to a seeded
# dev admin user (dev@local). Frontend mirrors this via
# NEXT_PUBLIC_AUTH_DISABLED. NEVER enable in production. Left commented out so
# that copying this template does not produce an unauthenticated API.
# AUTH_DISABLED=true


# =============================================================================
# LLM PROVIDERS
# =============================================================================
#
# Pick ONE of the four blocks below (matching LLM__PROVIDER). The unused
# blocks are safe to leave commented; missing keys raise on first call only
# for the active provider.

# --- OpenAI (also covers OpenAI-compatible endpoints: llama.cpp,
#             DeepSeek, Azure, Together AI, Groq, etc.) ----------------------
# [SECRET]
# LLM__OPENAI__API_KEY=sk-proj-...
# LLM__OPENAI__BASE_URL=                       # leave empty for openai.com
# LLM__OPENAI__EXPERT_MODEL=gpt-4o-mini
# LLM__OPENAI__JUDGE_MODEL=gpt-4o
# Repetition penalty forwarded to local OpenAI-compatible servers (llama.cpp /
# ik_llama.cpp) only when BASE_URL is set. 1.0 = off; ~1.15 breaks the small
# reasoning model out of degenerate ATT&CK ID-recall loops. Ignored by openai.com.
# LLM__OPENAI__REPETITION_PENALTY=1.15

# --- Anthropic -------------------------------------------------------------
# [SECRET]
# LLM__ANTHROPIC__API_KEY=sk-ant-...
# LLM__ANTHROPIC__EXPERT_MODEL=claude-sonnet-4-20250514
# LLM__ANTHROPIC__JUDGE_MODEL=claude-sonnet-4-20250514

# --- Ollama (local / air-gapped) -------------------------------------------
# LLM__OLLAMA__BASE_URL=http://localhost:11434
# LLM__OLLAMA__EXPERT_MODEL=qwen3.5:9b
# LLM__OLLAMA__JUDGE_MODEL=qwen3.5:9b
# LLM__OLLAMA__KEEP_ALIVE=30m
# LLM__OLLAMA__NUM_CTX=32768

# --- Google Gemini ---------------------------------------------------------
# [SECRET]
# LLM__GEMINI__API_KEY=AIza...
# LLM__GEMINI__EXPERT_MODEL=gemini-2.5-pro
# LLM__GEMINI__JUDGE_MODEL=gemini-2.5-pro

# --- ik_llama.cpp llama-server (recommended local setup) -------------------
# Drives the OpenAI block with a custom base URL. Launch via scripts/llm_server.sh
# (start / stop / status / wait) — it wraps the bench-validated Qwen3.6-35B-A3B-IQ3_K_R4
# flags for an 8 GB GPU (38-44 tok/s output).
# LLM__PROVIDER=openai
# LLM__OPENAI__API_KEY=dummy_key_no_auth_needed
# LLM__OPENAI__BASE_URL=http://127.0.0.1:8080/v1
# LLM__OPENAI__EXPERT_MODEL=qwen3.6-35b-a3b
# LLM__OPENAI__JUDGE_MODEL=qwen3.6-35b-a3b
# LLM__OPENAI__REPETITION_PENALTY=1.15        # recommended for this local model
# LLM__OPENAI__DISABLE_THINKING=true          # REQUIRED for this local setup.
#   Forwards chat_template_kwargs.enable_thinking=false. With Qwen3 thinking ON,
#   each analyst call emits a ~22k-token reasoning trace that never reaches
#   `content`, so the tool-less dynamic/network analysts time out at their hard
#   cap and the static Ghidra ReAct loop stalls -> degraded, zero-confidence
#   reports. OFF makes the model emit concise, convergent analyses (2026-06-23
#   live-UI audit: a correct claim in ~4s vs 0-char content after 800 thinking
#   tokens). Leave ON only on a large hosted model that needs the reasoning.


# =============================================================================
# HETEROGENEOUS MODEL ENSEMBLE (optional)
# =============================================================================
#
# Assign a different provider/model to each analyst agent. Reduces the
# single-model echo chamber identified by ReConcile (Chen et al., 2023).
# When an agent has no override it inherits the global expert model.
# Built-in agent names: static, dynamic, network.
#
# LLM__AGENTS__STATIC__PROVIDER=anthropic
# LLM__AGENTS__STATIC__MODEL=claude-3-5-sonnet-20241022
# LLM__AGENTS__STATIC__TEMPERATURE=0.15
#
# LLM__AGENTS__DYNAMIC__PROVIDER=openai
# LLM__AGENTS__DYNAMIC__MODEL=gpt-4o
# LLM__AGENTS__DYNAMIC__TEMPERATURE=0.10
#
# LLM__AGENTS__NETWORK__PROVIDER=ollama
# LLM__AGENTS__NETWORK__MODEL=llama3.1:8b
# LLM__AGENTS__NETWORK__TEMPERATURE=0.10


# =============================================================================
# LONG-TERM MEMORY / RAG
# =============================================================================
#
# Stores past analysis cases as fastembed/BGE 384-dim vectors. The judge
# retrieves the top-K most similar cases as weighted priors before every
# verdict. Without this each analysis starts from a blank slate.

# Backend: qdrant (persistent, default) | memory (in-process, ephemeral)
MEMORY__BACKEND=qdrant
MEMORY__QDRANT_URL=http://localhost:6333
MEMORY__QDRANT_COLLECTION=maljan_cases_v2
MEMORY__TOP_K=3


# =============================================================================
# SANDBOX / DYNAMIC ANALYSIS
# =============================================================================
#
# Two backends:
#   mock    - fixture JSON files from data/samples/dynamic/, no network
#   cape2   - local CAPEv2 instance (production / private samples)

SANDBOX__BACKEND=mock

# --- CAPEv2 (live sandbox, recommended for private samples) ----------------
# Submit/poll/fetch over the CAPEv2 REST API (/apiv2/...). The fetched
# report.json feeds BOTH the dynamic analyst (behavior.processes / apistats /
# signatures) and the network analyst (network.dns/http/tcp/udp/hosts). No
# shared filesystem is needed - the sample is uploaded as multipart bytes.
#
# CAPEv2 is not part of this repository: it needs a Linux host of its own with
# KVM and registered guest images, and this project only talks to its REST
# API. Bind CAPE's apiv2 to an address Maljan can reach, then point at it:
#       SANDBOX__CAPE2_BASE_URL=http://<CAPE_HOST>:8000
#
# SANDBOX__BACKEND=cape2
# SANDBOX__CAPE2_BASE_URL=http://<CAPE_HOST>:8000
# [SECRET]                                      # empty only for token_auth_enabled=no
# SANDBOX__CAPE2_API_TOKEN=
# Real detonation + report processing takes minutes; the 300s default is too
# low for a live VM. Use 1200s (20 min) and poll a touch slower.
# SANDBOX__CAPE2_TIMEOUT_SECONDS=1200
# SANDBOX__CAPE2_POLL_INTERVAL_SECONDS=15


# =============================================================================
# MCP SERVERS (Model Context Protocol)
# =============================================================================
#
# Each MCP block configures one external tool the agents can invoke as a
# LangChain tool. Both transports are supported per server:
#   stdio - local subprocess (command + args + env)
#   http  - remote REST API (url + auth_token)

# --- Ghidra MCP (static analysis via Ghidra headless Docker) ---------------
# Default stack: docker compose -f docker/docker-compose.yml up ghidra-mcp
# MCP__GHIDRA__ENABLED=true
# MCP__GHIDRA__TRANSPORT=http
# MCP__GHIDRA__URL=http://localhost:8089
# [SECRET]
# MCP__GHIDRA__AUTH_TOKEN=replace-with-a-strong-token

# --- CAPEv2 MCP (dynamic sandbox analysis exposed via MCP) -----------------
# Lets the dynamic analyst query CAPEv2 ad-hoc as LangChain tools
# (search_task, get_task_iocs, get_task_config, ...). Distinct from the
# SANDBOX__BACKEND=cape2 path: the SANDBOX path submits/fetches one report
# during preprocessing; the MCP path gives the agent interactive tools on top.
# Two transports:
#
#   (a) stdio - local subprocess. Only valid when CAPE is on THIS machine
#       (the wrapper launches CAPEv2's MCP server in-process / over wsl.exe).
#
#   (b) http  - remote CAPE on a separate VM. Run the wrapper ON THE VM as an
#       HTTP server, then point Maljan at it.
#       On the VM:
#         CAPE_ROOT=/opt/CAPEv2 CAPE_MCP_HOST=0.0.0.0 CAPE_MCP_PORT=9004 \
#           python scripts/cape_mcp_wrapper.py --transport streamable-http \
#           --cape-root /opt/CAPEv2
#       On Windows (streamable-http mounts at /mcp/):
#         MCP__CAPE__ENABLED=true
#         MCP__CAPE__TRANSPORT=http
#         MCP__CAPE__URL=http://<UBUNTU_VM_IP>:9004/mcp/
#         MCP__CAPE__AUTH_TOKEN=                 # only if the MCP server enforces one
#
# Local (stdio) example:
# MCP__CAPE__ENABLED=false
# MCP__CAPE__TRANSPORT=stdio
# MCP__CAPE__COMMAND=python
# MCP__CAPE__ARGS=["scripts/cape_mcp_wrapper.py", "--cape-root", "external/CAPEv2"]
# MCP__CAPE__ENV={}
# MCP__CAPE__URL=                               # http/sse transport only
# [SECRET]
# MCP__CAPE__AUTH_TOKEN=

# --- Direct env reads consumed by scripts/cape_mcp_wrapper.py --------------
# (set these ON THE VM when running the wrapper as an HTTP server)
# CAPE_ROOT=external/CAPEv2
# CAPE_MCP_TRANSPORT=stdio                      # stdio | sse | streamable-http
# CAPE_MCP_HOST=127.0.0.1                       # 0.0.0.0 to expose to the LAN
# CAPE_MCP_PORT=9004


# =============================================================================
# NEGOTIATION ENGINE
# =============================================================================
#
# Hard ceiling on negotiation rounds (the primary exit is Adaptive
# Termination via rolling std on confidence_history). The hard limit exists
# only to prevent runaway loops when adaptive convergence fails.
# NEGOTIATION__MAX_ITERATIONS=5
#
# Mediator confidence threshold for early consensus exit [0.0 - 1.0].
# NEGOTIATION__CONSENSUS_THRESHOLD=0.85


# =============================================================================
# BINARY CHUNKER
# =============================================================================
#
# Splits oversized analyst inputs into overlapping windows so each chunk
# fits within the LLM context. Increase max_tokens_per_chunk if your LLM
# supports a larger context window; increase overlap to preserve more
# cross-boundary context.
# CHUNKING__MAX_TOKENS_PER_CHUNK=6000
# CHUNKING__OVERLAP_TOKENS=200
# CHUNKING__SKIP_IF_FITS=true                   # false = always chunk (testing)


# =============================================================================
# PREPROCESSING
# =============================================================================
#
# Run a small/local LLM as a pre-summarizer over large function lists or
# decompiled blocks before they reach the expensive Expert LLMs. Off by
# default - the summarizer adds latency and only pays off for huge inputs.
# PREPROCESSING__USE_FUNCTION_SUMMARIZER=false
# PREPROCESSING__SUMMARIZER_PROVIDER=ollama
# PREPROCESSING__SUMMARIZER_MODEL=llama3.2:3b
# PREPROCESSING__SUMMARIZER_MAX_WORDS=150
# PREPROCESSING__MAX_TOOL_OUTPUT_CHARS=8000
#
# Family-feature RAG (LLM-centric static attribution). A deterministic
# static-feature profile of the sample is matched against an offline-built
# family fingerprint KB; the nearest families are injected into the static
# analyst as CANDIDATE evidence and the LLM decides. OFF by default; needs a
# vendored catalog (build with scripts/build_family_feature_kb.py) or it no-ops.
# PREPROCESSING__USE_FAMILY_FEATURE_RAG=false
# Vendored catalogs (point the path at whichever fits the run):
#   data/family_fingerprints_v1.json       n=210 bootstrap; perfect parity but tiny + eval-set leakage
#   data/family_fingerprints_mabel_v1.json MABEL features; 318 families, disjoint, --csv vocab mismatch
#   data/family_fingerprints_rat_v1.json   RAT-Collection; 278 families, perfect parity + disjoint +
#                                          real payload binaries (RECOMMENDED disjoint catalog)
# PREPROCESSING__FAMILY_FINGERPRINT_CATALOG_PATH=data/family_fingerprints_v1.json
# PREPROCESSING__FAMILY_RAG_TOP_K=5
# PREPROCESSING__FAMILY_RAG_MIN_SCORE=0.3
#
# ATT&CK case-prior RAG (LLM-centric, cross-sample TTP grounding). The sample
# profile retrieves behaviourally-similar PRIOR cases mined from our own
# long-term memory; their attributed technique_ids are aggregated into a ranked
# ATT&CK CANDIDATE list for the static analyst, and the LLM decides. OFF by
# default; needs a vendored corpus (build with scripts/build_attck_case_kb.py
# against a populated Qdrant LTM) or it no-ops.
# PREPROCESSING__USE_ATTCK_CASE_RAG=false
# PREPROCESSING__ATTCK_CASE_CORPUS_PATH=data/attck_case_corpus_v1.json
# PREPROCESSING__ATTCK_CASE_RAG_TOP_K=5
# PREPROCESSING__ATTCK_CASE_RAG_MIN_SCORE=0.35
# PREPROCESSING__ATTCK_CASE_RAG_MAX_TECHNIQUES=8


# =============================================================================
# ANALYSIS LAYER
# =============================================================================
#
# Directory containing Sigma rule YAML files. Loaded recursively. If the
# path does not exist the Sigma layer is gracefully disabled.
# ANALYSIS__SIGMA_RULES_DIR=data/sigma_rules


# =============================================================================
# REPORTING PIPELINE (Faz 2+)
# =============================================================================
#
# REPORTING__ENABLED=true                       # false skips report_node entirely
# REPORTING__INCLUDE_EXTENDED_STIX=true         # false halves serialization cost
# REPORTING__NARRATIVE_MAX_TOKENS=1500          # NarrativeAgent LLM round cap
# REPORTING__AUTO_GENERATE_DETECTION_RULES=true # YARA/Sigma/Suricata templates


# =============================================================================
# REACT AGENT EXECUTION LIMITS
# =============================================================================
#
# REACT_AGENT_TIMEOUT=180                       # default per-agent timeout (s)
# REACT_AGENT_MAX_STEPS=10                      # LangGraph recursion ceiling
# REACT_AGENT_TOOL_CALL_BUDGET=20               # WARN when cumulative calls exceed
#
# Per-agent timeout override. The default suits the network / dynamic
# analysts (~1-3 tool calls). The static analyst attaches Ghidra MCP with
# many tools, so it ships with 600s by default.
# REACT_AGENT_TIMEOUT_OVERRIDES__static=600
# REACT_AGENT_TIMEOUT_OVERRIDES__dynamic=180
# REACT_AGENT_TIMEOUT_OVERRIDES__network=180


# =============================================================================
# THREAT INTELLIGENCE
# =============================================================================
#
# Consumed by two subsystems:
#   1. The post-hoc enrichment worker (apps/api/app/worker/enrich_worker.py)
#      fills MalwareReport.network.{domains,ips}[*].reputation after the
#      verdict ships.
#   2. The legacy ThreatIntel MCP server (falls back to heuristic mock data
#      when keys are absent).
#
# Both providers are fail-safe: missing keys, HTTP errors, and rate-limit
# responses degrade gracefully without raising.
#
# [SECRET]
# VIRUSTOTAL_API_KEY=vt_api_key_here
# [SECRET]
# ABUSEIPDB_API_KEY=abuseipdb_key_here


# =============================================================================
# OBSERVABILITY - LangSmith / LangChain tracing
# =============================================================================
#
# When enabled, ServiceContainer propagates these values into the OS env
# vars LangChain reads automatically. Every LLM call, negotiation round,
# ISR construction, and TTP validation traces to the configured project.
# LANGCHAIN_TRACING_V2=false
# [SECRET]
# LANGCHAIN_API_KEY=ls_...
# LANGCHAIN_PROJECT=maljan


# =============================================================================
# MISCELLANEOUS
# =============================================================================
#
# Global LLM token safety cap - prompts are truncated before reaching this.
# Conservative for Gemini 1M+; raise it when running on a large-context model.
# MAX_TOKEN_LIMIT=128000
#
# Override the local MITRE ATT&CK STIX bundle cache directory. Read once at
# startup via os.environ.get; ``~`` is expanded.
# MALJAN_ATTCK_CACHE=~/.cache/maljan/attck/
#
# Auto-refresh threshold for the cached ATT&CK bundle, in days (default 30).
# Once the cache is older than this, the next load re-downloads the latest
# bundle from mitre-attack/attack-stix-data (a failed download falls back to
# the stale cache, so analysis never breaks offline). Set 0 (or negative) to
# disable the age check and keep the cache until it is missing / force-refreshed.
# Force an immediate refresh any time: python -m maljan.memory.attck_loader
# MALJAN_ATTCK_MAX_AGE_DAYS=30


# =============================================================================
# TEST / CI OVERRIDES (rarely needed in a normal .env)
# =============================================================================
#
# Skip the strict JWT_SECRET_KEY / MinIO secret validators in apps/api.
# Pytest already sets this implicitly via sys.modules detection.
# MALJAN_API_SKIP_SECRET_CHECK=1
#
# Pipeline mock-mode trigger. Has NO EFFECT unless the API also sets
# MOCK_MODE_ALLOWED=true (defence against leaked env vars silently
# disabling real LLM + sandbox calls).
# MALJAN_MOCK_MODE=false
