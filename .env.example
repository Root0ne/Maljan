# =============================================================================
# Maljan — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# Required: set LLM__PROVIDER and the matching API key block below.
# Everything else has sensible defaults and can be left commented out.
# =============================================================================


# =============================================================================
# MINIMUM SETUP (required for a real analysis run)
# =============================================================================

# Active LLM backend: openai | anthropic | ollama
LLM__PROVIDER=openai

# API key shortcuts — auto-promoted into the nested config on startup
OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...


# =============================================================================
# LLM PROVIDER SETTINGS
# =============================================================================

# --- OpenAI ---
# LLM__OPENAI__API_KEY=sk-proj-...         # alternative to flat OPENAI_API_KEY
# LLM__OPENAI__EXPERT_MODEL=gpt-4o-mini    # model for analyst agents
# LLM__OPENAI__JUDGE_MODEL=gpt-4o          # model for JudgeAgent

# --- Anthropic ---
# LLM__ANTHROPIC__API_KEY=sk-ant-...       # alternative to flat ANTHROPIC_API_KEY
# LLM__ANTHROPIC__EXPERT_MODEL=claude-sonnet-4-20250514
# LLM__ANTHROPIC__JUDGE_MODEL=claude-sonnet-4-20250514

# --- Ollama (local / air-gapped) ---
# LLM__PROVIDER=ollama
# LLM__OLLAMA__BASE_URL=http://localhost:11434
# LLM__OLLAMA__EXPERT_MODEL=qwen3.5:9b
# LLM__OLLAMA__JUDGE_MODEL=qwen3.5:9b


# =============================================================================
# HETEROGENEOUS MODEL ENSEMBLE (optional — reduces echo chamber risk)
# =============================================================================
#
# Assign a different provider/model to each analyst agent. When unset, all
# agents share the global expert LLM defined above.
#
# Research basis: ReConcile (Chen et al., 2023) and Wu et al. (2024) show
# that different model families produce more accurate and less sycophantic
# multi-agent outputs than single-model ensembles.
#
# LLM__AGENTS__STATIC__PROVIDER=anthropic
# LLM__AGENTS__STATIC__MODEL=claude-3-5-sonnet-20241022
# LLM__AGENTS__STATIC__TEMPERATURE=0.15
#
# LLM__AGENTS__DYNAMIC__PROVIDER=openai
# LLM__AGENTS__DYNAMIC__MODEL=gpt-4o
# LLM__AGENTS__DYNAMIC__TEMPERATURE=0.10
#
# LLM__AGENTS__NETWORK__PROVIDER=ollama
# LLM__AGENTS__NETWORK__MODEL=llama3.1:8b
# LLM__AGENTS__NETWORK__TEMPERATURE=0.10


# =============================================================================
# LANGSMITH OBSERVABILITY (optional — full trace visibility)
# =============================================================================
#
# When enabled, ServiceContainer propagates these values into the OS env vars
# that LangChain reads automatically. All LLM calls, negotiation rounds, ISR
# constructions, and TTP validations are traced to your LangSmith project.
#
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls_...
# LANGCHAIN_PROJECT=maljan-dev     # default: "maljan"


# =============================================================================
# NEGOTIATION ENGINE TUNING (optional)
# =============================================================================

# Hard upper bound on negotiation rounds (2 is sufficient for most samples)
# NEGOTIATION__MAX_ITERATIONS=2

# Mediator confidence threshold for early consensus exit [0.0 – 1.0]
# NEGOTIATION__CONSENSUS_THRESHOLD=0.85


# =============================================================================
# BINARY CHUNKER TUNING (optional)
# =============================================================================
#
# Controls how large malware artifacts are split before LLM consumption.
# Increase MAX_TOKENS_PER_CHUNK if your LLM supports a larger context window.
# Increase OVERLAP_TOKENS to preserve more cross-boundary context.

# CHUNKING__MAX_TOKENS_PER_CHUNK=6000
# CHUNKING__OVERLAP_TOKENS=200

# Set to false to always chunk even small inputs (useful for testing)
# CHUNKING__SKIP_IF_FITS=true


# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Global token safety cap — prompts are truncated before reaching this limit
# MAX_TOKEN_LIMIT=8000

# Override the local ATT&CK STIX bundle cache directory
# MALJAN_ATTCK_CACHE=~/.cache/maljan/attck/


# =============================================================================
# LONG-TERM MEMORY / RAG (optional — Phase 5)
# =============================================================================
#
# Enables few-shot context injection into JudgeAgent.give_verdict().
# Past analysis cases are retrieved by cosine similarity on ISR claim text
# and inserted as a LONG-TERM MEMORY block before every verdict LLM call.
#
# backend: "memory" (default, in-process) | "qdrant" (persistent vector DB)
#
# --- In-Process (default, no external dependencies) ---
# MEMORY__BACKEND=memory
#
# --- Qdrant (persistent, semantic search) ---
# Requires: uv add qdrant-client && docker run -p 6333:6333 qdrant/qdrant
# MEMORY__BACKEND=qdrant
# MEMORY__QDRANT_URL=http://localhost:6333
# MEMORY__QDRANT_COLLECTION=maljan_cases
#
# Number of similar past cases injected into the judge prompt (default: 3)
# MEMORY__TOP_K=3


# =============================================================================
# SANDBOX INTEGRATION (optional — Phase 6)
# =============================================================================
#
# Controls how dynamic analysis data is obtained.
# The sandbox client is built by ServiceContainer.get_sandbox_client() and
# can be passed to FileDataLoader.load_from_sandbox() for live sample analysis.
#
# backend: "mock" (default, uses fixture JSON files) | "cape2" (live CAPEv2)
#
# --- Mock (default, no external dependencies) ---
# Uses existing fixture files from data/samples/dynamic/ for testing.
# SANDBOX__BACKEND=mock
#
# --- CAPEv2 (live sandbox — requires httpx + running CAPEv2 instance) ---
# Requires: uv add httpx
# Start CAPEv2: https://github.com/kevoreilly/CAPEv2
# SANDBOX__BACKEND=cape2
# SANDBOX__CAPE2_BASE_URL=http://cape2-host:8000
# SANDBOX__CAPE2_API_TOKEN=your_cape2_api_token
#
# --- Triage (live sandbox — requires httpx + Hatching Triage API) ---
# SANDBOX__BACKEND=triage
# SANDBOX__TRIAGE_BASE_URL=https://api.tria.ge/v0
# SANDBOX__TRIAGE_API_TOKEN=your_triage_api_token
#
# Task completion polling settings:
# SANDBOX__CAPE2_TIMEOUT_SECONDS=300
# SANDBOX__CAPE2_POLL_INTERVAL_SECONDS=10

# =============================================================================
# PREPROCESSING & OPTIMIZATION (optional)
# =============================================================================
#
# Use a smaller/cheaper LLM to pre-summarize large function lists or decompiled
# blocks before they reach the expensive Expert LLMs.
# PREPROCESSING__USE_FUNCTION_SUMMARIZER=true


# =============================================================================
# THREAT INTELLIGENCE (optional — Phase 2)
# =============================================================================
#
# Configure real VirusTotal and AbuseIPDB lookups for the ThreatIntel MCP server.
# Without these keys the MCP falls back to heuristic mock data.
#
# VIRUSTOTAL_API_KEY=vt_api_key_here
# ABUSEIPDB_API_KEY=abuseipdb_key_here

# =============================================================================
# MCP SERVER INTEGRATION (optional)
# =============================================================================
#
# --- Ghidra MCP (static analysis via Ghidra headless Docker) ---
# The headless server runs in Docker and exposes 165 REST endpoints.
# No WSL, no GUI, no local Ghidra installation required.
#
# MCP__GHIDRA__ENABLED=true
# MCP__GHIDRA__TRANSPORT=http
# MCP__GHIDRA__URL=http://localhost:8089
# MCP__GHIDRA__AUTH_TOKEN=your_ghidra_mcp_secret
#
# --- CAPEv2 MCP (dynamic sandbox analysis) ---
# MCP__CAPE__ENABLED=true
# MCP__CAPE__COMMAND=python
# MCP__CAPE__ARGS=["scripts/cape_mcp_wrapper.py", "--cape-root", "external/CAPEv2"]
# MCP__CAPE__ENV={}
