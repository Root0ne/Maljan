# Required by docker compose. Generate the three infrastructure secrets with:
#   python -c "import secrets; [print(f'{k}={secrets.token_urlsafe(32)}') for k in ('GHIDRA_MCP_AUTH_TOKEN','REDIS_PASSWORD','QDRANT_API_KEY')]"
GHIDRA_MCP_AUTH_TOKEN=
REDIS_PASSWORD=
QDRANT_API_KEY=

# ── Ghidra MCP and Qdrant ────────────────────────────────────────────────────
# Both run by default: the compose file starts each only under its profile,
# and this line turns both profiles on. To run without one, take its name out
# (an empty value runs neither); that service's token above is then not
# needed. Without Ghidra, pick another static analyser in the console
# (core.static.provider); without Qdrant, set core.memory.backend = memory.
# Each of the two, when on, does not start without its token: it restarts and
# logs the variable to set.
COMPOSE_PROFILES=ghidra,qdrant

# ── Backend user ─────────────────────────────────────────────────────────────
# The uid and gid the api, worker, enrichment worker and migration run as;
# unset, the image's own unprivileged account (10001:10001). On a host where a
# login user also works in this checkout's data/ (a development machine), set
# both to that user's ids (`id -u`, `id -g`) so data/samples and data/uploads
# stay that user's. The volume-init service hands those two and the ATT&CK
# cache volume to this id on every `up`; 0 is refused.
# MALJAN_UID=10001
# MALJAN_GID=10001

# ── Postgres ─────────────────────────────────────────────────────────────────
# The database password, used by the postgres service and by the DATABASE_URL
# compose assembles for the migrate / api / worker services. No baked-in
# default: a development password that ships to a real deployment is still the
# password on that deployment.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# On a stack that already has a pgdata volume, set the password that volume was
# initialised with: Postgres reads POSTGRES_PASSWORD only when it creates the
# data directory, so a new value here would simply fail to authenticate.
POSTGRES_PASSWORD=

# ── Ghidra MCP container (`ghidra` profile) ─────────────────────────────────
# Unset, each keeps the value the compose file names: the image's JVM options
# (-Xmx4g -XX:+UseG1GC), a 6g memory-and-swap limit, restart unless-stopped.
# A lighter host: GHIDRA_JAVA_OPTS="-Xmx2g -XX:+UseG1GC", GHIDRA_MEM_LIMIT=4g,
# and GHIDRA_RESTART=no to start Ghidra only for the runs that need it.
#GHIDRA_JAVA_OPTS=
#GHIDRA_MEM_LIMIT=
#GHIDRA_RESTART=

# ── Identification sidecars (`die`, `ilspy`, `goresym` profiles) ─────────────
# Detect It Easy, ILSpy and GoReSym, one container each, off by default. To run
# one, add its profile to COMPOSE_PROFILES above, set its token here, and in
# the console switch the server block of the same name on with that token as
# its auth_token. Each refuses to start without its token.
#DIE_MCP_AUTH_TOKEN=
#ILSPY_MCP_AUTH_TOKEN=
#GORESYM_MCP_AUTH_TOKEN=
# Each container's memory-and-swap ceiling, a machine-safety limit as Ghidra's
# is (a file past it fails its call, not the host). Unset: 2g, 4g, 2g.
#DIE_MEM_LIMIT=
#ILSPY_MEM_LIMIT=
#GORESYM_MEM_LIMIT=

# ── Rule and document sidecars (`yarax`, `oletools`, `webcrack` profiles) ────
# YARA-X over your own YARA rule files, oletools over Office and RTF documents,
# webcrack over JavaScript droppers, one container each, off by default, run
# the same way as the identification sidecars above. YARA-X reads the rule
# files (*.yar, *.yara) under data/yara-x-rules, or the directory set here
# (absolute, or relative to docker/).
#YARAX_MCP_AUTH_TOKEN=
#OLETOOLS_MCP_AUTH_TOKEN=
#WEBCRACK_MCP_AUTH_TOKEN=
#YARA_X_RULES_DIR=
# Each container's memory-and-swap ceiling, as above. Unset: 2g each.
#YARAX_MEM_LIMIT=
#OLETOOLS_MEM_LIMIT=
#WEBCRACK_MEM_LIMIT=

# Where published ports bind. 127.0.0.1 keeps every service off the network;
# set 0.0.0.0 only behind a firewall or reverse proxy you control.
BIND_ADDRESS=127.0.0.1

# ── MinIO root credentials ────────────────────────────────────────────────────
# Required by the minio service and, as MINIO_ACCESS_KEY/MINIO_SECRET_KEY, by
# the backend-api / backend-worker services (part of their bootstrap contract).
# No baked-in default any more — "minioadmin" is a placeholder the startup
# bootstrap check refuses outside debug mode.
MINIO_ROOT_USER=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MINIO_ROOT_PASSWORD=

# ── Audit chain anchor (optional) ────────────────────────────────────────────
# Where the audit chain's head is kept outside its database: database,
# object_store or none (see the root ``bootstrap.env.example``). Unset, the
# chain is checked against its database head only, and verification says so.
# AUDIT_ANCHOR=
# [SECRET] - a role that may only INSERT and SELECT audit_chain_anchor.
# AUDIT_ANCHOR_DATABASE_URL=postgresql+asyncpg://maljan_anchor:<password>@postgres:5432/maljan

# ── Application bootstrap secrets ────────────────────────────────────────────
# Required by the backend-api / backend-worker services (see the root
# ``bootstrap.env.example`` for the full contract these two belong to).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=
