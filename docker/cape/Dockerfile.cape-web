# CAPEv2 web + REST API container (no VM, no scheduler).
#
# What this gives you:
#   - Django web UI at :8000
#   - REST API at /apiv2/* — the exact endpoints maljan's CAPEv2Client speaks
#   - PostgreSQL-backed task database
#   - NO sample analysis (the scheduler / KVM stack isn't in the container)
#
# Submissions create a task row but stay in "pending" until a real CAPE
# worker picks them up. To run actual analyses you still need a Linux host
# with KVM and Windows guest VMs registered. See docs/CAPE2_DOCKER_INTEGRATION.md.

FROM ubuntu:22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# ── System dependencies ─────────────────────────────────────────────
# Trimmed from installer/cape2.sh — only what the Django web app + its
# transitive Python C-extensions need. Skips KVM, Suricata, Tor, mono,
# de4dot — they belong to the analysis/scheduler side.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        locales \
        tzdata \
        python3.10 \
        python3.10-dev \
        python3-pip \
        python3-setuptools \
        python3-wheel \
        build-essential \
        pkg-config \
        git \
        curl \
        libssl-dev \
        libffi-dev \
        libfuzzy-dev \
        libmagic-dev \
        libpcap-dev \
        libjpeg-dev \
        zlib1g-dev \
        libpq-dev \
        libgeoip-dev \
        libre2-dev \
        libgraphviz-dev \
        libxml2-dev \
        libxslt1-dev \
        graphviz \
        ssdeep \
        exiftool \
        netcat-openbsd \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps ─────────────────────────────────────────────────────
# Install from the pinned but UN-hashed pyproject deps. The full lock
# file pulls many heavy extras (volatility3, bingraph, etc.) that the
# web component does not need; using pyproject keeps the image lean.
WORKDIR /opt/CAPEv2
COPY external/CAPEv2/pyproject.toml /tmp/pyproject.toml
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --no-build-isolation \
        # Core Django + DRF + DB drivers
        "Django>=4.2.18" \
        "djangorestframework==3.15.2" \
        "django-recaptcha==4.0.0" \
        "django-crispy-forms==2.3" \
        "crispy-bootstrap4==2024.10" \
        "django-settings-export==1.2.1" \
        "django-csp==3.8" \
        "django-extensions==3.2.3" \
        "django-ratelimit==4.1.0" \
        "django-allauth==65.13.0" \
        "Jinja2>=3.1.6" \
        "Werkzeug==3.1.5" \
        # ORM + alembic
        "SQLAlchemy==2.0.41" \
        "SQLAlchemy-Utils==0.41.1" \
        "alembic==1.9.4" \
        "psycopg2-binary>=2.9.10" \
        # CAPE runtime essentials
        "gevent==24.2.1" \
        "greenlet==3.0.3" \
        "Pebble==5.1.0" \
        "cryptography>=44.0.1" \
        "requests[security,socks]==2.32.4" \
        "pefile" \
        "tldextract>=5.1.2" \
        "oletools==0.60.2" \
        "olefile==0.47" \
        "capstone==5.0.5" \
        "pycryptodomex>=3.20.0" \
        "requests-file>=1.5.1" \
        "orjson>=3.9.15" \
        "pyzipper==0.3.6" \
        "Cython==3.0.11" \
        "chardet==4.0.0" \
        "pygal==2.4.0" \
        "dpkt==1.9.6" \
        "dnspython==2.7.0" \
        "pytz==2021.1" \
        "maxminddb==2.6.3" \
        "Pillow>=8.2.0" \
        "python-whois==0.9.5" \
        "bs4==0.0.1" \
        "pydeep2==0.5.1" \
        "yara-python==4.5.1" \
        "pymongo>=4.0.1" \
        "LnkParse3==1.5.0" \
        "cachetools>=5.5.1" \
        "paramiko==3.5.0" \
        "psutil==6.1.1" \
        "peepdf-3==5.0.0" \
        "python-tlsh==4.5.0" \
        "packaging==24.2" \
        "setuptools==78.1.1" \
        "flare-capa==9.3.1" \
    && python3 -m pip install --no-build-isolation "SFlock2[linux,shellcode]>=0.3.76" || true

# pyre2 needs libre2-dev (installed above) but the wheel is finicky; treat
# it as optional. If it fails the web app still boots — only some signature
# modules use it.
RUN python3 -m pip install --no-build-isolation pyre2>=0.3.10 || \
    echo "pyre2 install skipped (non-critical for REST API path)"

# settings.py INSTALLED_APPS lists daphne + channels (ASGI / WebSocket
# plumbing) which aren't in pyproject's default deps. Without them Django
# refuses to boot. The ``guac`` app is in-tree (web/guac/) so no pip
# package needed for that one.
RUN python3 -m pip install --no-build-isolation \
        "daphne>=4.1.0" \
        "channels>=4.0.0" \
        "pyguacamole>=0.10.0"

# ── CAPEv2 source ───────────────────────────────────────────────────
COPY external/CAPEv2/ /opt/CAPEv2/

# Copy the shipped defaults into the active conf/ slots — entrypoint
# then patches the ones that need Docker-specific values.
RUN bash -c 'cd /opt/CAPEv2 && for f in conf/default/*.conf.default; do \
        cp -f "$f" "conf/$(basename ${f%.default})"; \
    done'

# ── Entrypoint ──────────────────────────────────────────────────────
COPY docker/cape/entrypoint.sh /usr/local/bin/cape-entrypoint.sh
RUN chmod +x /usr/local/bin/cape-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/cape-entrypoint.sh"]
CMD ["web"]
