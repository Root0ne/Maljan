# ── Maljan Backend Dockerfile ────────────────────────
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285 AS base

WORKDIR /app

# System dependencies.
# The pango/harfbuzz trio and the DejaVu fonts are WeasyPrint's runtime
# requirement for /reports/{id}/pdf (Phase 6). WeasyPrint loads them through
# ctypes at call time, not at import, so without them the PDF endpoint would
# 503 at runtime while everything else kept working — easy to miss. DejaVu is
# the last entry in the report stylesheet's font stack and the only one that
# exists in a slim image; drop it and every glyph falls back to a default.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gcc libpq-dev \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /usr/local/bin/uv

# Manifests first, sources second: the dependency layer stays cached across
# every source edit. Both workspace members' manifests are needed, because the
# root lockfile resolves them together. README.md rides along because the root
# [project] declares it as its readme, and hatchling refuses to build a wheel
# whose declared readme is absent.
COPY pyproject.toml uv.lock README.md ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml

# Install the workspace.
# ``--all-packages`` is what installs the maljan-api member: a plain `uv sync`
# at a workspace root resolves every member but installs only the root project,
# so without it `import app` would fail exactly where PYTHONPATH used to cover.
# 2026-07 round 2: include the ``yara`` extra so yara-python is available in the
# backend image — otherwise detection_signatures._validate_yara reports
# "yara-python not installed; rule body not validated" for every generated rule.
# The manylinux wheel bundles libyara, so no system package is required.
RUN uv sync --frozen --no-dev --all-packages --extra yara --no-install-workspace

# Sources. Both members are installed editable from here, so `maljan` and `app`
# import with no PYTHONPATH: the ENV that used to set it is gone, and so is the
# sys.path.insert the worker carried.
COPY src/ src/
COPY apps/ apps/
COPY data/ data/
COPY services/ services/

RUN uv sync --frozen --no-dev --all-packages --extra yara

# The workspace venv is the image's interpreter. Without this, a bare `python`
# is the system one, which sees neither the dependencies nor the two editable
# members — the old image papered over half of that with ENV PYTHONPATH, which
# reached the sources but never the dependencies. compose still starts both
# services through `uv run`; this only makes a plain `python` agree with it.
ENV PATH="/app/.venv/bin:${PATH}"

# Expose API port
EXPOSE 8000

# Default command (overridden in docker-compose)
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
