# ── Maljan Backend Dockerfile ────────────────────────
FROM python:3.13-slim AS base

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy project files
COPY pyproject.toml uv.lock ./
COPY src/ src/
COPY apps/ apps/
COPY external/ external/
COPY data/ data/
COPY threatintel-mcp/ threatintel-mcp/
COPY network-mcp/ network-mcp/

# Install dependencies
RUN uv sync --frozen --no-dev

# Set PYTHONPATH so `app.*` (apps/api) AND `maljan.*` (src) both resolve.
# F1 (2026-07-05): adding /app/src makes the core ``maljan`` package
# importable from the API process too — the on-demand markdown re-render
# (report_service.get_malware_report_markdown) imports it, and without src
# on the path /reports/{id}/markdown 500'd with ModuleNotFoundError.
ENV PYTHONPATH="/app/apps/api:/app/src:${PYTHONPATH}"

# Expose API port
EXPOSE 8000

# Default command (overridden in docker-compose)
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
