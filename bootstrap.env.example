# =============================================================================
# Maljan - bootstrap.env.example
# =============================================================================
#
# This is the ENTIRE process-environment surface the API and the worker read.
# It is validated once at startup (`apps/api/app/bootstrap.py`); a missing
# required variable, an empty or default JWT secret outside debug, or an
# invalid `SETTINGS_ENCRYPTION_KEY` aborts the process with one message
# naming every problem at once.
#
# Every OTHER application setting (LLM provider, sandbox, static analyst,
# tool servers, agents, rate limits, enrichment, ...) lives in the settings
# store and is edited from the web UI (Settings -> Configuration), exported
# and imported as JSON — never as environment variables. There is no
# automatic import of a previous `.env` deployment: the store is the only
# source of truth and this file is never read for anything but the variables
# below.
#
# Quickstart:
#
#   cp bootstrap.env.example bootstrap.env      # gitignored
#   # fill in the two secrets below, then either:
#   #   - export them into your shell (set -a; . ./bootstrap.env; set +a)
#   #     before running the API/worker directly, or
#   #   - `make dev-up` / `make migrate`, which source this file for you.
#
# Conventions:
#   - `# KEY=value` means the key is optional and the value shown is the
#     default; uncomment only to override it.
#   - Anything marked [SECRET] must never be committed.
# =============================================================================


# ── Database (required) ──────────────────────────────────────────────────────
# The password is the one Postgres was initialised with (POSTGRES_PASSWORD in docker/.env).
DATABASE_URL=postgresql+asyncpg://maljan:<postgres-password>@127.0.0.1:5433/maljan
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# Auto-run `alembic upgrade head` at startup. Production deployments should
# run migrations as a separate deploy step instead (`make migrate`).
# RUN_MIGRATIONS_ON_STARTUP=false


# ── Redis (required) ─────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0


# ── MinIO / S3 (endpoint + keys required) ────────────────────────────────────
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
# [SECRET] - boot refuses in non-debug mode while this is unset or "minioadmin".
# Against the compose stack this is docker/.env's MINIO_ROOT_PASSWORD.
MINIO_SECRET_KEY=
# MINIO_BUCKET=maljan-samples
# MINIO_SECURE=false


# ── Settings-store encryption (required) ─────────────────────────────────────
# Fernet key that encrypts every secret saved in the runtime settings store.
# Without a valid key the process refuses to start — "secrets stay in .env"
# no longer exists, so there is no read-only fallback mode.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# [SECRET]
SETTINGS_ENCRYPTION_KEY=


# ── JWT auth (required outside debug) ────────────────────────────────────────
# Generate: openssl rand -hex 32
# Boot refuses in non-debug mode when unset, shorter than 32 characters, or a
# known placeholder ("change-me", "secret", etc.).
# [SECRET]
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_ISSUER=maljan-api
# JWT_AUDIENCE=maljan-clients
# Secret rotation (SEC-JWT-ROTATION-01): set the previous secret/kid here
# during a rotation window; both are accepted until every old token expires.
# JWT_KEY_ID=v1
# [SECRET]
# JWT_PREVIOUS_SECRET_KEY=
# JWT_PREVIOUS_KEY_ID=v0


# ── Application (optional) ───────────────────────────────────────────────────
# APP_NAME=Maljan
# APP_VERSION=0.1.0
# DEBUG=false
# Echo every SQL statement to the log. Deliberately independent of DEBUG.
# SQL_ECHO=false


# ── CORS (optional) ───────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
# CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Correlation-Id","X-API-Key"]


# ── Cookie (optional) ─────────────────────────────────────────────────────────
# Secure flag on the HttpOnly refresh cookie. Unset by default so it follows
# DEBUG (Secure outside debug); set explicitly to override either way.
# COOKIE_SECURE=


# ── Auth bypass — local development only (optional) ──────────────────────────
# Skips every JWT check and attributes all requests to a fixed seeded admin
# user. NEVER enable this outside a trusted local environment.
# AUTH_DISABLED=false
# AUTH_DISABLED_USER_ID=00000000-0000-0000-0000-000000000001
# AUTH_DISABLED_USER_EMAIL=dev@local
# AUTH_DISABLED_USER_FULL_NAME=Dev User


# ── Mount-shaped paths (optional) ─────────────────────────────────────────────
# Host directory bind-mounted into the Ghidra container.
# SAMPLES_DIR=data/samples
# Defender-excluded scratch directory for sample uploads and worker tempfiles.
# UPLOAD_TEMP_DIR=data/uploads/.tmp
# Path at which the Ghidra container sees SAMPLES_DIR; must match the
# right-hand side of the samples bind mount in docker/docker-compose.yml.
# GHIDRA_CONTAINER_SAMPLES_PATH=/data/samples
