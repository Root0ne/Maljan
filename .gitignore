# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-wsl
**/.venv/

# External MCP tool installations (not part of Maljan — install separately)
external/

# Runtime sample mirror — worker copies MinIO-downloaded samples into
# data/samples/ so the Ghidra container can read them through its mount.
# These are real binaries, not test fixtures, so never commit them.
# Test fixtures under data/samples/{dynamic,network,static}/ stay tracked.
data/samples/*.apk
data/samples/*.exe
data/samples/*.dll
data/samples/*.elf
data/samples/*.so
data/samples/*.dex
data/samples/*.jar
data/samples/*.bin
data/samples/*.dat
data/samples/*.sys
data/samples/*.macho

# Runtime upload staging — the API streams uploads through
# data/uploads/.tmp (Defender-excluded) before pushing to MinIO. Ephemeral.
data/uploads/

# Environment variables (never commit real secrets)
# Tracked: .env.example, .env.template, apps/*/. env.example
# Ignored: every real .env and any *.local override anywhere in the tree.
.env
.env.*.local
.env.local
**/.env
!**/.env.example
!**/.env.template
**/.env.local
**/.env.*.local

# Generated datasets (large, produced by prepare-* scripts)
# attck_valid_ids.json IS committed (small); labeled sentences is not.
data/attck_labeled_sentences.jsonl

# Real malware samples (must never be committed to a public repo)
samples/

# Local LLM model weights (large, downloaded separately)
models/
*.gguf
*.safetensors

# Local reference PDFs (Twitter threads, papers — collected per machine)
docs/twitter/

# Local analysis outputs
reports/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.serena/cache/

# Frontend
node_modules/
apps/web/.next/
apps/web/out/

*.log

.claude/settings.local.json
# Wave 9 (2026-05-29): ephemeral cron lock — Claude /schedule writes
# this per-session and should never have been tracked. Removed from
# the repo in the same commit that added it here.
.claude/scheduled_tasks.lock

# Live-malware dataset mirrors (full download, 2026-06-08). data/samples is
# Defender-excluded; these are real malware archives/binaries, never committed.
data/samples/rat-collection/
data/samples/dike/
data/samples/extracted/

# A/B eval transient checkpoints (regenerated per run)
tests/evaluation/ab_off.jsonl
tests/evaluation/ab_on.jsonl
tests/evaluation/ab_off.partial.jsonl
