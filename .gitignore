# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-wsl
**/.venv/

# External MCP tool installations (not part of Maljan — install separately)
external/

# Runtime sample mirror — worker copies MinIO-downloaded samples into
# data/samples/ so the Ghidra container can read them through its mount.
# These are real binaries, not test fixtures, so never commit them.
# Test fixtures under data/samples/{dynamic,network,static}/ stay tracked.
data/samples/*.apk
data/samples/*.exe
data/samples/*.dll
data/samples/*.elf
data/samples/*.so
data/samples/*.dex
data/samples/*.jar
data/samples/*.bin
data/samples/*.dat
data/samples/*.sys
data/samples/*.macho

# Runtime upload staging — the API streams uploads through
# data/uploads/.tmp (Defender-excluded) before pushing to MinIO. Ephemeral.
data/uploads/

# Environment variables (never commit real secrets)
# Tracked: .env.example, .env.template, apps/*/. env.example
# Ignored: every real .env and any *.local override anywhere in the tree.
.env
.env.*.local
.env.local
**/.env
!**/.env.example
!**/.env.template
**/.env.local
**/.env.*.local

# Generated datasets (large, produced by prepare-* scripts)
# attck_valid_ids.json IS committed (small); labeled sentences is not.
data/attck_labeled_sentences.jsonl

# Real malware samples (must never be committed to a public repo)
samples/

# Local LLM model weights (large, downloaded separately)
models/
*.gguf
*.safetensors

# Local reference PDFs (Twitter threads, papers — collected per machine)
docs/twitter/

# Third-party threat-analysis reports, collected while reading. Not ours to
# redistribute: one carries a TLP:AMBER marking, which is a limited-distribution
# marking that a public repository breaks. 18 MB, and read by nothing here.
/analiz raporları/
*.pdf.tlp

# docs/ carries the manuscript and the three supplements the paper says the
# artefact contains. Everything else under it was written while the work was
# being done rather than to be read afterwards, and lives under other/docs/.
docs/research/
docs/font/
docs/migration/
docs/report-reference/
docs/AUDIT_*.md
docs/CONTINUE_ON_WINDOWS.md
other/docs/academic-article/findings-log.md
other/docs/academic-article/literature-review-brief.md
other/docs/academic-article/paper-roadmap.md
other/docs/academic-article/self-audit-pitfalls.md
other/docs/academic-article/research-briefs/

# Local analysis outputs
reports/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.serena/cache/

# Frontend
node_modules/
apps/web/.next/
apps/web/out/

*.log

.claude/settings.local.json
# Wave 9 (2026-05-29): ephemeral cron lock — Claude /schedule writes
# this per-session and should never have been tracked. Removed from
# the repo in the same commit that added it here.
.claude/scheduled_tasks.lock

# Live-malware dataset mirrors (full download, 2026-06-08). data/samples is
# Defender-excluded; these are real malware archives/binaries, never committed.
data/samples/rat-collection/
data/samples/dike/
data/samples/extracted/

# A/B eval transient checkpoints (regenerated per run)
tests/evaluation/ab_off.jsonl
tests/evaluation/ab_on.jsonl
tests/evaluation/ab_off.partial.jsonl

# Local transfer helper containing a GitHub token — never commit
_GITHUB_SETUP.txt

# Playwright run artefacts (screenshots, traces, error contexts from failed runs)
apps/web/test-results/
apps/web/playwright-report/

# Overnight watch output (machine-local, not project history)
logs/

# External corpora — fetched by eval scripts, never vendored
data/external/

# CAPE analysis reports fetched for the n=100 dynamic cohort. ~7 MB each,
# ~660 MB for the cohort, and reproducible from the committed task ledger
# (tests/evaluation/cape_task_ledger_n100.json) plus the instance. The ledger
# is the artifact worth versioning; these are its bulky output.
data/cape_reports/

# built paper artifacts (regenerate with build_paper.py)
other/docs/academic-article/paper/build/

# LaTeX build products. The sources and the generated facts.tex are tracked; a
# .aux is a compiler's scratch file and reviewing its diff is noise.
other/docs/academic-article/paper/tex/*.aux
other/docs/academic-article/paper/tex/*.log
other/docs/academic-article/paper/tex/*.out
other/docs/academic-article/paper/tex/*.toc
other/docs/academic-article/paper/tex/*.fls
other/docs/academic-article/paper/tex/*.xdv
other/docs/academic-article/paper/tex/*.fdb_latexmk
other/docs/academic-article/paper/tex/*.blg
other/docs/academic-article/paper/tex/*.spl
# submission bundle: a rebuildable view of files already tracked above
# (make_submission.py assembles it for Editorial Manager)
other/docs/academic-article/paper/submission/
other/docs/academic-article/paper/tex/.facts-inputs.sha256
1-s2.0-S0921889026003003-main.pdf
makale_yazim.md
elsarticle.zip
Guide for authors - Computers & Security*.html
Guide for authors - Computers & Security*_files/

# Everything that is deliberately not part of the repository lives here:
# third-party threat reports, the journal's guide and class files, reference
# PDFs, drafts. One directory rather than a scatter of root-level entries, so
# "is this ours" is answered by where a file sits.
/other/

# The Sigma corpus is SigmaHQ's, under the Detection Rule License, and was
# committed here as 2,651 files carrying neither their licence nor their names.
# scripts/fetch_external.sh clones it at a pinned release instead, licence file
# and all.
data/sigma_rules/
