# Normalize all text files to LF on commit.
# This prevents ruff format --check failures in CI (Linux) when
# files are edited on Windows (CRLF).

* text=auto eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.whl binary

# Packet captures are bytes, including the ones that read as text.
tests/fixtures/pcap/*.pcap binary
tests/fixtures/pcap/*.pcapng binary
